# =============================================================================
# Pipeline configuration: every path and analysis parameter lives here
# =============================================================================

general:
  project_name: {{ env_name }}
  random_seed: 1618
  log_level: INFO
  n_cores: 4

paths:
  data: data
  models: models
  outputs: outputs
  logs: logs

# Every input and output file, relative to the project root.
data:
  # Inputs: taken in and never modified, one folder per source
  # (data/inputs/<source>/). Names as received, except files whose name gave
  # no source, content or date (original name in the comment). Input file
  # names appear here and nowhere else.
  inputs: {}
  derivatives: {}
  models: {}
  outputs: {}

# Analysis parameters and specification switches
parameters: {}

output:
  figure_format: [pdf, png]
  dpi: 600
  # Project colours, merged over the shared entries of manuscript_colors():
  # one per group, predictor or measure, from the Tol palettes in
  # get_palette(), with a comment saying why each was chosen (docs/STYLE.md)
  colors: {}
  # Slide versions of figures, PNG only: no title or caption (the slide
  # heading carries them). Each is drawn at the size of the area it fills on
  # the 1600 x 900 px slide (inches at slide_dpi, shown at one image pixel
  # per slide pixel), in IBM Plex Sans at slide_text_px (the size of the
  # slide captions), so figure and slide type match. Areas: full width and
  # the wider column of the two column layouts (the extension's slides.scss)
  slide_dpi: 200
  slide_text_px: 30
  slide_areas:
    full: [8, 3.0]
    columns_7: [4.52, 3.0]
    columns_6: [3.88, 3.0]
    columns_5: [3.235, 3.0]
  table_formats: [html, tex]

scripts:
  # One flag per script with a cache check; set true to re-run, then back
  force_regenerate: {}

packages:
  required: [data.table, here, yaml]
  optional: []
